# Copy to .env and fill in. .env is gitignored; this template is not, so it must
# never contain a real value.
#
# A real environment variable always beats this file, so a one-off override works:
#   ROBOFLOW_API_KEY=other_key acquire fetch roboflow_placas_colombianas

# Roboflow Universe — free key, from https://app.roboflow.com -> Settings -> API Keys.
# Needed by: roboflow_placas_colombianas, roboflow_placas_colombia_itm,
#            roboflow_proyecto_placas   [Phase 1]
ROBOFLOW_API_KEY=

# Where datasets, the corpus and the real test set live. Defaults to ./data.
# Point this at an external drive if the internal disk is tight (CCPD is 13.2 GB).
#ALPR_DATA_ROOT=/Volumes/external/alpr

# Commercial OCR baseline, for the "should I have just bought this" comparison.
# Not needed until Sprint 5.3 — leave blank.
#COMMERCIAL_OCR_API_KEY=

# Sender details for the UFPR-ALPR / RodoSol-ALPR licence-request emails
# (`acquire email <source> --write`). Kept out of code so no personal data is
# committed. Leave blank and the draft shows placeholders.
CONTACT_NAME=
CONTACT_EMAIL=
